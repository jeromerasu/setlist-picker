LOG_LEVEL=INFO
ENV=dev
DATABASE_URL=postgresql+asyncpg://postgres:dev@localhost/setlist
JWT_SECRET=replace-with-32-byte-secret

# CORS — comma-separated list of allowed origins (empty = no CORS middleware)
CORS_ORIGINS=[]

# Trusted hosts — default "*" bypasses TrustedHostMiddleware
TRUSTED_HOSTS=["*"]

# Apple Sign-In
APPLE_BUNDLE_ID=com.setlistpicker.app
APPLE_JWKS_URL=https://appleid.apple.com/auth/keys

# Google Sign-In
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
